rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify the user owns this record
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to prevent client-side privilege escalation
    function isNotEscalatingPrivileges() {
      return (!('membershipTier' in request.resource.data) ||
              !('membershipTier' in resource.data) ||
              request.resource.data.membershipTier == resource.data.membershipTier ||
              request.resource.data.membershipTier == 'FREE');
    }

    // User's private learning state & progress
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
        (!('membershipTier' in request.resource.data) || request.resource.data.membershipTier == 'FREE');
      allow update: if isOwner(userId) && isNotEscalatingPrivileges();
      allow delete: if isOwner(userId);
    }
    
    // User's specific subcollections if any
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Beta feedback: Authenticated users can write (create) and read their own feedback, but cannot edit or delete it
    match /beta_feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
